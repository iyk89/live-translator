[{"pageIndex":0,"box":{"pageWidth":595,"pageHeight":842,"pageX":0,"pageY":0},"rotation":0,"content":{"items":[{"str":"신경망 기계 번역은 하나의 학습 가능한 네트워크로 한 언어의 문장을 다른 언어의 문장으로","dir":"ltr","transform":[11,0,0,11,72,700.527],"width":441.452,"height":11,"fontName":"g_d0_f1","hasEOL":true},{"str":"옮긴다. 초기의 인코더-디코더 시스템은 원문 전체를 고정 길이의 벡터 하나로 압축했기","dir":"ltr","transform":[11,0,0,11,72,682.171],"width":420.189,"height":11,"fontName":"g_d0_f1","hasEOL":true},{"str":"때문에 긴 문장을 번역하기 어려웠다. 어텐션 메커니즘은 디코더가 매 단계마다 원문의 모든","dir":"ltr","transform":[11,0,0,11,72,663.815],"width":441.54,"height":11,"fontName":"g_d0_f1","hasEOL":true},{"str":"위치를 참고할 수 있게 하여 이 병목을 없앴다.","dir":"ltr","transform":[11,0,0,11,72,645.459],"width":221.056,"height":11,"fontName":"g_d0_f1","hasEOL":false},{"str":"","dir":"ltr","transform":[15,0,0,15,72,476.355],"width":0,"height":0,"fontName":"g_d0_f1","hasEOL":true},{"str":"注意機構とニューラル機械翻訳","dir":"ltr","transform":[15,0,0,15,72,476.355],"width":210,"height":15,"fontName":"g_d0_f1","hasEOL":false},{"str":"","dir":"ltr","transform":[11,0,0,11,72,440.527],"width":0,"height":0,"fontName":"g_d0_f1","hasEOL":true},{"str":"ニューラル機械翻訳は、一つの学習可能なネットワークによって、ある言語の文を別の言語","dir":"ltr","transform":[11,0,0,11,72,440.527],"width":451,"height":11,"fontName":"g_d0_f1","hasEOL":true},{"str":"の文に変換する。初期のエンコーダ・デコーダ方式では、原文全体を固定長のベクトル一つ","dir":"ltr","transform":[11,0,0,11,72,422.171],"width":451,"height":11,"fontName":"g_d0_f1","hasEOL":true},{"str":"に圧縮していたため、長い文の翻訳が難しかった。注意機構は、デコーダが各ステップで原","dir":"ltr","transform":[11,0,0,11,72,403.815],"width":451,"height":11,"fontName":"g_d0_f1","hasEOL":true},{"str":"文のすべての位置を参照できるようにすることで、この問題を解消した。","dir":"ltr","transform":[11,0,0,11,72,385.459],"width":363,"height":11,"fontName":"g_d0_f1","hasEOL":false}],"styles":{"g_d0_f1":{"fontFamily":"sans-serif","ascent":1.04296875,"descent":-0.265625,"vertical":false}}}}]