{
  "name": "passage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.9",
    "idb": "^8.0.3",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.48.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "jsdom": "^30.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "scripts": {
    "dev": "node scripts/copy-pdfjs-assets.mjs && concurrently -k -n api,web -c blue,green \"tsx watch server/index.ts\" \"vite\"",
    "build": "node scripts/copy-pdfjs-assets.mjs && tsc -b && vite build && vite build --ssr server/index.ts --outDir dist/server",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "fixtures": "python3 fixtures/generate.py"
  }
}
