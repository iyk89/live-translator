# Passage server settings.
# Copy this file to ".env" (same folder) and fill in what you need.
# The server reads .env when it starts; restart it after changes.

# ---------------------------------------------------------------------------
# Translation: Claude (default)
# ---------------------------------------------------------------------------
# Required for translation. Create a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Model used for translation (default: claude-opus-5).
# PASSAGE_TRANSLATION_MODEL=claude-opus-5

# Reasoning effort: low (default, fastest) | medium | high | xhigh | max | none
# Use "none" for models that don't accept it (for example claude-haiku-4-5).
# PASSAGE_TRANSLATION_EFFORT=low

# If the model declines a passage, retry it on Anthropic's recommended fallback
# model inside the same request. Set to false for models or platforms without it.
# PASSAGE_REFUSAL_FALLBACK=true

# ---------------------------------------------------------------------------
# Translation: local model instead (optional, no API key, text stays local)
# ---------------------------------------------------------------------------
# Requires Ollama (https://ollama.com) running on this computer, and a model
# pulled once, for example:  ollama pull qwen3:8b
# PASSAGE_TRANSLATION_PROVIDER=ollama
# PASSAGE_TRANSLATION_MODEL=qwen3:8b
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# PORT=8787
# HOST=127.0.0.1
# Behind a reverse proxy, set true so rate limits use X-Forwarded-For.
# PASSAGE_TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------
# PASSAGE_MAX_FILE_MB=25
# PASSAGE_MAX_PAGES=200
# PASSAGE_MAX_SELECTION_CHARS=6000
# PASSAGE_TRANSLATE_RATE_PER_MIN=30
# PASSAGE_TRANSLATE_CONCURRENCY=4
# PASSAGE_TRANSLATE_TIMEOUT_MS=90000
# PASSAGE_IMPORT_RATE_PER_MIN=10
# PASSAGE_IMPORT_TIMEOUT_MS=25000
